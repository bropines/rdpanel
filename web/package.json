{
  "name": "rdpanel-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scarfSettings": {
    "enabled": false
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "node scripts/go-ignore-node-modules.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "dev:mock": "vite --mode mock",
    "build:mock": "tsc -b && vite build --mode mock",
    "preview:mock": "vite preview --mode mock --outDir dist-mock --port 4174 --strictPort",
    "screenshots": "playwright test --config e2e/playwright.config.ts screenshots",
    "e2e": "playwright test --config e2e/playwright.config.ts smoke",
    "e2e:real": "playwright test --config e2e/real/playwright.config.ts --grep-invert @screenshots",
    "screenshots:real": "playwright test --config e2e/real/playwright.config.ts --grep @screenshots"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.130.0",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "i18next": "^25.5.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.544.0",
    "marked": "^18.1.1",
    "qrcode": "^1.5.4",
    "rdweb": "https://github.com/bropines/rdweb/releases/download/v0.7.2/rdweb-0.7.2.tgz",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.0",
    "sonner": "^2.0.7",
    "swagger-ui-dist": "^5.33.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.9.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
