{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rustdesk-panel values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "portNumber": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "nodePort": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1, "maximum": 65535 }
      ]
    },
    "duration": {
      "type": "string",
      "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "cidrList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$" }
    },
    "svcPort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "$ref": "#/definitions/portNumber" },
        "nodePort": { "$ref": "#/definitions/nodePort" }
      },
      "required": ["enabled", "port"]
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "$ref": "#/definitions/stringMap" },
    "commonAnnotations": { "$ref": "#/definitions/stringMap" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "replicaCount": {
      "description": "0 (stopped) or 1. More than one replica is not supported: hbbs keeps state in memory, the panel uses SQLite and the server key pair must be unique.",
      "type": "integer",
      "enum": [0, 1]
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relay": { "type": "string" },
        "encryptedOnly": { "type": "boolean" },
        "alwaysUseRelay": { "type": "boolean" },
        "mustLogin": { "type": "boolean" },
        "env": { "$ref": "#/definitions/stringMap" }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen", "dataDir"],
      "properties": {
        "listen": {
          "description": "host:port; the port must be explicit",
          "type": "string",
          "pattern": "^(\\[[0-9a-fA-F:.]*\\]|[^:\\[\\]]*):[0-9]{1,5}$"
        },
        "publicURL": {
          "type": "string",
          "pattern": "^$|^https?://[^/?#@\\s]+(/[^?#\\s]*)?$"
        },
        "dataDir": { "type": "string", "pattern": "^/" },
        "hbbsPublicKeyFile": { "type": "string", "pattern": "^/" },
        "hbbsIdServer": { "type": "string", "pattern": "^[^\\s]+:[0-9]{1,5}$" },
        "hbbsRelayServer": { "type": "string", "pattern": "^[^\\s]+:[0-9]{1,5}$" },
        "trustedProxies": { "$ref": "#/definitions/cidrList" },
        "realIPHeader": { "enum": ["X-Forwarded-For", "X-Real-IP", "CF-Connecting-IP"] },
        "metricsAllow": { "$ref": "#/definitions/cidrList" },
        "tokenLifetime": { "$ref": "#/definitions/duration" },
        "jwtLifetime": { "$ref": "#/definitions/duration" },
        "sessionIdle": { "$ref": "#/definitions/duration" },
        "sessionAbsolute": { "$ref": "#/definitions/duration" },
        "log": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": { "enum": ["debug", "info", "warn", "error"] },
            "format": { "enum": ["json", "text"] }
          }
        },
        "env": { "$ref": "#/definitions/stringMap" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "jwtKeyKey": { "type": "string", "minLength": 1 },
        "secretKeyKey": { "type": "string", "minLength": 1 },
        "jwtKey": { "type": "string" },
        "secretKey": {
          "description": "base64 of exactly 32 bytes (openssl rand -base64 32)",
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9+/_-]{43}=?$"
        },
        "setSecretKey": { "type": "boolean" },
        "keep": { "type": "boolean" }
      }
    },
    "serverKeys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "privateKeyKey": { "type": "string", "minLength": 1 },
        "publicKeyKey": { "type": "string", "minLength": 1 },
        "privateKey": { "type": "string" },
        "publicKey": { "type": "string" }
      }
    },
    "hostNetwork": { "type": "boolean" },
    "dnsPolicy": { "enum": ["", "ClusterFirst", "ClusterFirstWithHostNet", "Default", "None"] },
    "dnsConfig": { "type": "object" },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "natTest": { "$ref": "#/definitions/portNumber" },
        "rendezvous": { "$ref": "#/definitions/portNumber" },
        "relay": { "$ref": "#/definitions/portNumber" },
        "rendezvousWs": { "$ref": "#/definitions/portNumber" },
        "relayWs": { "$ref": "#/definitions/portNumber" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "$ref": "#/definitions/portNumber" },
        "nodePort": { "$ref": "#/definitions/nodePort" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "loadBalancerIP": { "type": "string" },
        "loadBalancerClass": { "type": "string" },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } },
        "externalTrafficPolicy": { "enum": ["", "Local", "Cluster"] },
        "ipFamilyPolicy": { "enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"] },
        "ipFamilies": { "type": "array", "items": { "enum": ["IPv4", "IPv6"] } }
      }
    },
    "rendezvous": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "externalTrafficPolicy": { "enum": ["Local", "Cluster"] },
            "split": { "type": "boolean" },
            "loadBalancerIP": { "type": "string" },
            "loadBalancerClass": { "type": "string" },
            "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } },
            "annotations": { "$ref": "#/definitions/stringMap" },
            "tcpAnnotations": { "$ref": "#/definitions/stringMap" },
            "udpAnnotations": { "$ref": "#/definitions/stringMap" },
            "labels": { "$ref": "#/definitions/stringMap" },
            "ipFamilyPolicy": { "enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"] },
            "ipFamilies": { "type": "array", "items": { "enum": ["IPv4", "IPv6"] } },
            "healthCheckNodePort": { "$ref": "#/definitions/nodePort" },
            "ports": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "natTest": { "$ref": "#/definitions/svcPort" },
                "rendezvousTcp": { "$ref": "#/definitions/svcPort" },
                "rendezvousUdp": { "$ref": "#/definitions/svcPort" },
                "relay": { "$ref": "#/definitions/svcPort" },
                "rendezvousWs": { "$ref": "#/definitions/svcPort" },
                "relayWs": { "$ref": "#/definitions/svcPort" }
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["paths"],
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": { "type": "string", "pattern": "^/" },
                    "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "matches": { "type": "array", "minItems": 1 },
        "websocketRules": { "type": "boolean" }
      }
    },
    "websocket": {
      "type": "object",
      "properties": {
        "service": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "annotations": { "$ref": "#/definitions/stringMap" }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "$ref": "#/definitions/stringMap" },
            "labels": { "$ref": "#/definitions/stringMap" },
            "hosts": {
              "type": "array",
              "items": { "type": "object", "properties": { "host": { "type": "string" } } }
            },
            "idPath": { "type": "string", "pattern": "^/" },
            "relayPath": { "type": "string", "pattern": "^/" },
            "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
            "tls": { "type": "array" }
          }
        }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "extraContainers": { "type": "array" },
    "initContainers": { "type": "array" },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"] }
        },
        "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "selector": { "type": "object" },
        "mountPath": { "type": "string", "pattern": "^/" },
        "subPath": { "type": "string" },
        "retentionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "whenDeleted": { "enum": ["Retain", "Delete"] },
            "whenScaled": { "enum": ["Retain", "Delete"] }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "priorityClassName": { "type": "string" },
    "runtimeClassName": { "type": "string" },
    "schedulerName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "hostAliases": { "type": "array" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "command": { "type": "array", "items": { "type": "string" } },
    "args": { "type": "array", "items": { "type": "string" } },
    "lifecycle": { "type": "object" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["httpGet", "exec"] },
        "path": { "type": "string", "pattern": "^/" },
        "startup": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" }
      }
    },
    "customStartupProbe": { "type": "object" },
    "customLivenessProbe": { "type": "object" },
    "customReadinessProbe": { "type": "object" },
    "updateStrategy": { "type": "object" },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "path": { "type": "string", "pattern": "^/" },
        "scheme": { "enum": ["http", "https"] },
        "tlsConfig": { "type": "object" },
        "relabelings": { "type": "array" },
        "metricRelabelings": { "type": "array" },
        "honorLabels": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressControllerNamespaceSelector": { "type": "object" },
        "ingressControllerPodSelector": { "type": "object" },
        "metricsNamespaceSelector": { "type": "object" },
        "extraPanelFrom": { "type": "array" },
        "rendezvousFrom": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "egress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "rules": { "type": "array" }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["null", "integer", "string"] },
        "maxUnavailable": { "type": ["null", "integer", "string"] }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "dryRun": { "type": "boolean" },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": { "type": "string" },
            "hostPath": { "type": "string" },
            "subPath": { "type": "string" },
            "mountPath": { "type": "string", "pattern": "^/" },
            "readOnly": { "type": "boolean" }
          }
        },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": ["null", "integer"] },
        "ttlSecondsAfterFinished": { "type": ["null", "integer"] },
        "resources": { "type": "object" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    }
  }
}
