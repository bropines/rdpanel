#!/command/with-contenv sh
# hbbs (ID/rendezvous server): 21115 NAT test + loopback admin, 21116 tcp/udp,
# 21118 WebSocket. Reads id_ed25519 and db_v2.sqlite3 from its cwd (/data).
#
# Env: RELAY          -> -r <relay servers>, comma separated host[:port]
#      ENCRYPTED_ONLY -> 1 adds `-k _` (only clients that know the key)
#      KEY            -> read by hbbs itself when ENCRYPTED_ONLY is not 1
#      WS_RELAY_SERVERS
#                     -> relays offered to WebSocket (browser) clients; defaults
#                        to the first RELAY entry: browsers reach the local hbbr
#                        through the panel's reverse proxy (/ws/relay), not
#                        remote relay agents in the rotation
#      AUTHZ_URL, AUTHZ_SECRET_FILE
#                     -> the panel's connection authorization endpoint and
#                        its secret; derived from RDPANEL_LISTEN and
#                        RDPANEL_HBBS_AUTHZ_SECRET_FILE when unset
#                        (/usr/libexec/rdpanel/hbbs-authz-env)
#      ALWAYS_USE_RELAY, MUST_LOGIN, TCP_KEEPALIVE, WEBRTC, RUSTDESK_API_JWT_KEY,
#      TRUSTED_PROXIES, WS_PEERS, WS_KEY_EXCHANGE, RUST_LOG
#                     -> read by hbbs itself from the environment (with-contenv
#                        and as-service-user keep the container env)
exec 2>&1
# Relay host mode (RDPANEL_MODE=agent): only the agent service works; it runs
# hbbr itself. This service idles.
if [ "${RDPANEL_MODE:-panel}" = agent ]; then exec /command/s6-pause; fi
cd /data || exit 1

set --
if [ -n "${RELAY:-}" ]; then set -- "$@" -r "$RELAY"; fi
# The reverse proxy the panel trusts for client IPs is the one in front of
# hbbs' WebSocket port too.
if [ -z "${TRUSTED_PROXIES:-}" ] && [ -n "${RDPANEL_TRUSTED_PROXIES:-}" ]; then
	TRUSTED_PROXIES=$RDPANEL_TRUSTED_PROXIES
	export TRUSTED_PROXIES
fi
if [ -z "${WS_RELAY_SERVERS+x}" ] && [ -n "${RELAY:-}" ]; then
	WS_RELAY_SERVERS=${RELAY%%,*}
	export WS_RELAY_SERVERS
fi
if [ "${ENCRYPTED_ONLY:-0}" = 1 ]; then set -- "$@" -k _; fi

# MUST_LOGIN tokens are verified with RUSTDESK_API_JWT_KEY. When it is not set
# on the container, use the panel's generated key file (see key-secret) so the
# panel and hbbs always agree.
if [ -z "${RUSTDESK_API_JWT_KEY:-}" ]; then
	f=${RDPANEL_JWT_KEY_FILE:-${RDPANEL_DATA_DIR:-/data/panel}/jwt.key}
	if [ -s "$f" ]; then
		RUSTDESK_API_JWT_KEY=$(cat "$f")
		export RUSTDESK_API_JWT_KEY
	fi
fi

# Connection rules and control roles: hbbs asks the panel before every
# punch-hole / relay request (AUTHZ_URL, AUTHZ_SECRET_FILE; key-secret has
# created the secret file). RDPANEL_HBBS_AUTHZ=false turns it off.
. /usr/libexec/rdpanel/hbbs-authz-env

exec /usr/libexec/rdpanel/as-service-user /usr/bin/hbbs "$@"
