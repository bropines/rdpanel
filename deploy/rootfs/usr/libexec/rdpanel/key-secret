#!/command/with-contenv sh
# s6-rc oneshot "key-secret": prepares /data before hbbs, hbbr and the panel
# start. Runs as root; everything else runs as PUID:PGID.
#
# 1. hbbs key pair (/data/id_ed25519{,.pub}), in this order of precedence:
#      existing files in /data  >  docker secrets /run/secrets/key_{priv,pub}
#      >  env KEY_PRIV / KEY_PUB  >  freshly generated pair.
#    Both halves or neither must be provided; a provided pair is validated.
#    Same semantics as the upstream rustdesk-server s6 image, except that a
#    missing pair is generated here (with rustdesk-utils, the same libsodium
#    ed25519 keys hbbs would write) instead of by hbbs itself: hbbs and hbbr
#    would otherwise race to create the files on first start, and hbbs writes
#    the private key with the process umask (0644).
# 2. Panel JWT key: when RUSTDESK_API_JWT_KEY is unset, make sure the panel's
#    jwt.key file exists so that the hbbs run script can export the very same
#    key to hbbs (MUST_LOGIN token verification).
# 3. Ownership: /data and the panel data dir are chowned to PUID:PGID
#    (skipped when PUID=0), so data dirs from root-run images keep working.
#
# Any failure stops the container (S6_BEHAVIOUR_IF_STAGE2_FAILS=2).
set -eu

log() { echo "[key-secret] $*"; }
die() { log "FATAL: $*"; exit 1; }

DATA=/data
PANEL_DATA=${RDPANEL_DATA_DIR:-/data/panel}
PUID=${PUID:-10001}
PGID=${PGID:-10001}
SK="$DATA/id_ed25519"
PK="$DATA/id_ed25519.pub"

case "$PUID$PGID" in *[!0-9]*|'') die "PUID/PGID must be numeric (got '$PUID:$PGID')" ;; esac

umask 077
mkdir -p "$DATA" "$PANEL_DATA"

# --- 1. hbbs key pair -------------------------------------------------------
# Existing keys are never overwritten. If a provided key differs from the one
# already in /data, warn and keep the existing file (delete it to replace).
warn_differs() { # <file> <provided-content> <source>
	if [ -e "$1" ] && [ "$(tr -d ' \r\n' < "$1")" != "$(printf '%s' "$2" | tr -d ' \r\n')" ]; then
		log "WARNING: $3 differs from existing $1; keeping the existing key (remove the file to replace it)"
	fi
}
[ -r /run/secrets/key_pub ] && warn_differs "$PK" "$(cat /run/secrets/key_pub)" "docker secret key_pub"
[ -r /run/secrets/key_priv ] && warn_differs "$SK" "$(cat /run/secrets/key_priv)" "docker secret key_priv"
[ -n "${KEY_PUB:-}" ] && warn_differs "$PK" "$KEY_PUB" "KEY_PUB"
[ -n "${KEY_PRIV:-}" ] && warn_differs "$SK" "$KEY_PRIV" "KEY_PRIV"

if [ ! -e "$PK" ] && [ -r /run/secrets/key_pub ]; then
	cp /run/secrets/key_pub "$PK"; log "public key taken from docker secret key_pub"
fi
if [ ! -e "$SK" ] && [ -r /run/secrets/key_priv ]; then
	cp /run/secrets/key_priv "$SK"; log "private key taken from docker secret key_priv"
fi
if [ ! -e "$PK" ] && [ -n "${KEY_PUB:-}" ]; then
	printf '%s' "$KEY_PUB" > "$PK"; log "public key taken from KEY_PUB"
fi
if [ ! -e "$SK" ] && [ -n "${KEY_PRIV:-}" ]; then
	printf '%s' "$KEY_PRIV" > "$SK"; log "private key taken from KEY_PRIV"
fi

if [ -e "$PK" ] && [ ! -e "$SK" ]; then die "$PK exists but $SK is missing: provide BOTH keys"; fi
if [ ! -e "$PK" ] && [ -e "$SK" ]; then die "$SK exists but $PK is missing: provide BOTH keys"; fi

if [ ! -e "$SK" ]; then
	# Same rule as hbbs (common.rs gen_sk): avoid '/' and ':' in the public key.
	i=0
	while :; do
		out=$(rustdesk-utils genkeypair) || die "rustdesk-utils genkeypair failed"
		pub=$(printf '%s\n' "$out" | sed -n 's/^Public Key: *//p')
		sec=$(printf '%s\n' "$out" | sed -n 's/^Secret Key: *//p')
		[ -n "$pub" ] && [ -n "$sec" ] || die "unexpected rustdesk-utils output"
		i=$((i + 1))
		case "$pub" in */*|*:*) [ "$i" -lt 300 ] && continue ;; esac
		break
	done
	printf '%s' "$sec" > "$SK.tmp" && mv "$SK.tmp" "$SK"
	printf '%s' "$pub" > "$PK.tmp" && mv "$PK.tmp" "$PK"
	unset sec out
	log "generated new key pair, public key: $pub"
else
	rustdesk-utils validatekeypair "$(cat "$PK")" "$(cat "$SK")" >/dev/null \
		|| die "key pair in $DATA is not valid (rustdesk-utils validatekeypair)"
	log "using existing key pair, public key: $(cat "$PK")"
fi
chmod 0600 "$SK"
chmod 0644 "$PK"

# --- 2. JWT key shared by the panel and hbbs ---------------------------------
if [ -z "${RUSTDESK_API_JWT_KEY:-}" ]; then
	JWT_FILE=${RDPANEL_JWT_KEY_FILE:-$PANEL_DATA/jwt.key}
	if [ ! -s "$JWT_FILE" ]; then
		mkdir -p "$(dirname "$JWT_FILE")"
		# 48 random bytes, unpadded base64url: the format rdpanel itself writes.
		head -c 48 /dev/urandom | base64 | tr -d '\n=' | tr '+/' '-_' > "$JWT_FILE.tmp"
		mv "$JWT_FILE.tmp" "$JWT_FILE"
		log "RUSTDESK_API_JWT_KEY not set: generated $JWT_FILE (shared with hbbs)"
	else
		log "RUSTDESK_API_JWT_KEY not set: using $JWT_FILE (shared with hbbs)"
	fi
	chmod 0600 "$JWT_FILE"
fi

# --- 3. ownership --------------------------------------------------------------
if [ "$PUID" != 0 ]; then
	for d in "$DATA" "$PANEL_DATA"; do
		find "$d" \( ! -user "$PUID" -o ! -group "$PGID" \) -exec chown -h "$PUID:$PGID" {} +
	done
fi
log "data dir ready (services run as $PUID:$PGID)"
