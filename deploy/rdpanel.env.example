# RD Panel (rdpanel) container environment. Copy to rdpanel.env next to
# compose.yml, adjust, and keep it private (chmod 600): it holds secrets.
# Every variable is optional unless marked REQUIRED; the value shown is the
# default unless the comment says otherwise.
# Full reference: docs/deploy.md (Environment reference) for the container and
# docs/configuration.md for every RDPANEL_* setting (some are not listed here).

# ============================================================== container / s6
# Numeric uid/gid that hbbs, hbbr and the panel run as. The startup oneshot
# chowns /data (and the panel data dir) to it. PUID=0 runs everything as root.
PUID=10001
PGID=10001
# IANA time zone for log timestamps (tzdata is installed).
#TZ=Europe/Moscow

# ============================================================== hbbs / hbbr
# REQUIRED in practice: relay server(s) hbbs hands to clients, comma separated
# host[:port] (port defaults to 21117). Usually this server's public name.
RELAY=rustdesk.example.com
# 1 = start hbbs and hbbr with `-k _`: only clients configured with this
# server's public key (/data/id_ed25519.pub) may use them. hbbs already
# requires the key by default; this mainly makes hbbr enforce it too.
# Image default: 0 (same as the upstream image). Recommended: 1.
ENCRYPTED_ONLY=1
# Force every connection through the relay (no P2P hole punching): Y or N.
#ALWAYS_USE_RELAY=N
# Only clients logged in to the panel may connect (hbbs checks the client's
# token, an HS256 JWT signed with RUSTDESK_API_JWT_KEY): Y or N. This is a UX
# gate (no revocation in hbbs, relay requests are not checked).
#MUST_LOGIN=N
# Keepalive for clients in TCP/WebSocket mode ("Use WebSocket", UDP blocked,
# proxies): Y = hbbs sends an empty frame every 12 s on their rendezvous
# connection, so they stay online. N (upstream behaviour) = such clients show
# online only ~30 s after each re-registration (every ~90 s). Needs the
# bropines/rustdesk-server build in this image; also settable at runtime on
# the panel's Server page (which then overrides this value).
#TCP_KEEPALIVE=N
# WebRTC signaling for RustDesk 1.5+ clients that have "Enable WebRTC" on: Y =
# hbbs forwards the WebRTC offer/answer and ICE candidates so they can connect
# peer-to-peer over ICE (or a TURN server, see docs/webrtc.md). N (upstream
# behaviour) = WebRTC is not offered. Also settable at runtime on the panel's
# Server page (which then overrides this value).
#WEBRTC=N
# Shared HS256 key for client tokens: the panel signs with it, hbbs verifies
# MUST_LOGIN tokens with it. Raw string, byte-for-byte (not base64-decoded).
# Set it to the SAME value as the old lejianwen rustdesk-api when migrating,
# so already-issued client tokens keep working. When unset, the image
# generates $RDPANEL_DATA_DIR/jwt.key on first start and gives it to both.
#RUSTDESK_API_JWT_KEY=
# hbbs/hbbr key pair for first start only (ignored once /data/id_ed25519{,.pub}
# exist; a differing value only logs a warning, the existing key is kept).
# Raw file contents. Both or neither. Docker secrets key_priv/key_pub work
# the same way.
# Without them a fresh pair is generated.
#KEY_PRIV=
#KEY_PUB=
# hbbr bandwidth limits in Mb/s (read by hbbr at start; the panel can change
# them at runtime through the admin channel).
#LIMIT_SPEED=
#SINGLE_BANDWIDTH=
#TOTAL_BANDWIDTH=
# hbbs/hbbr log level (env_logger syntax), e.g. info or debug.
#RUST_LOG=info
# Do NOT set PORT or KEY unless you know why: hbbr listens on PORT+1, and KEY
# overrides the key-file logic for both daemons.

# ============================================================== panel (rdpanel)
# HTTP bind address. Keep it on loopback and put a TLS reverse proxy in front.
# Image default: :21114 (all interfaces).
RDPANEL_LISTEN=127.0.0.1:21114
# Public base URL clients use as "API server" (OIDC callbacks, HSTS, links).
RDPANEL_PUBLIC_URL=https://desk-api.example.com
# Panel base URL when the panel UI + /api/v1 live on another (internal) host than
# the public client API; OIDC panel logins are handed off there. Default: public URL.
#RDPANEL_ADMIN_URL=https://desk-admin.internal.example.com
# Panel data directory: panel.db, secret.key, jwt.key. Default in the image.
#RDPANEL_DATA_DIR=/data/panel
#RDPANEL_DB_PATH=/data/panel/panel.db
# AEAD key for secrets at rest: base64 of exactly 32 bytes. When unset it is
# generated into RDPANEL_SECRET_KEY_FILE. Back that file up with panel.db.
#RDPANEL_SECRET_KEY=
#RDPANEL_SECRET_KEY_FILE=/data/panel/secret.key
# Used when RUSTDESK_API_JWT_KEY is unset (also read by the hbbs run script).
#RDPANEL_JWT_KEY_FILE=/data/panel/jwt.key
# Sliding lifetime of client tokens (panel DB) and the fixed JWT exp lifetime
# seen by hbbs (default: same as RDPANEL_TOKEN_LIFETIME). Go durations.
#RDPANEL_TOKEN_LIFETIME=4380h
#RDPANEL_JWT_LIFETIME=
# Panel (web) session idle / absolute lifetime.
#RDPANEL_SESSION_IDLE=12h
#RDPANEL_SESSION_ABSOLUTE=168h
# Passkeys (WebAuthn) for panel sign-in. The relying party id defaults to the
# host of RDPANEL_ADMIN_URL (else RDPANEL_PUBLIC_URL) and the allowed origin to
# its origin. Set the RP id to a parent domain to share passkeys across hosts;
# changing it later invalidates registered passkeys. Browsers need https (or
# http://localhost) and a host name, not an IP address.
#RDPANEL_WEBAUTHN_RP_ID=example.com
#RDPANEL_WEBAUTHN_ORIGINS=https://desk-admin.internal.example.com
# Peers whose forwarding header is trusted for the client IP (IPs/CIDRs,
# comma separated), and which header: X-Forwarded-For, X-Real-IP or
# CF-Connecting-IP. Only list proxies that overwrite/append that header.
#RDPANEL_TRUSTED_PROXIES=127.0.0.0/8,::1/128
#RDPANEL_REAL_IP_HEADER=X-Forwarded-For
# Client IPs allowed to read /metrics.
#RDPANEL_METRICS_ALLOW=127.0.0.0/8,::1/128
# Export rdpanel_presence_device_online{id=...}: one series per device, so
# only for small fleets (docs/monitoring.md).
#RDPANEL_METRICS_PER_DEVICE=false
# hbbs rendezvous and hbbr relay addresses as seen from the panel (same
# container: loopback). The hbbs admin channel is the rendezvous port - 1.
#RDPANEL_HBBS_ID_SERVER=127.0.0.1:21116
#RDPANEL_HBBS_RELAY_SERVER=127.0.0.1:21117
#RDPANEL_HBBS_PUBLIC_KEY_FILE=/data/id_ed25519.pub
# Public host[:port] of this container's hbbr (the "local" relay on Server ->
# Relays); default: the first entry of RELAY. Relay agents: docs/relay-agents.md.
#RDPANEL_HBBS_RELAY_PUBLIC_HOST=rustdesk.example.com
# Log level (debug, info, warn, error) and format (json, text).
#RDPANEL_LOG_LEVEL=info
#RDPANEL_LOG_FORMAT=json
# About page release check (GitHub API, cached 6 h). false = no outbound request.
#RDPANEL_UPDATE_CHECK=true
# Optional YAML config file (env vars override it).
#RDPANEL_CONFIG=

# ============================================================== healthcheck
# TCP ports that must be listening for the container to be healthy.
#HEALTHCHECK_PORTS=21115 21116 21117 21118 21119
